

# --- API keys -------------------------------------------------------------
# Jupiter's Swap API needs a key: https://developers.jup.ag/portal
# Without one, the jupiter source is disabled at startup.
JUPITER_API_KEY=

# LI.FI works without a key but /v1/quote is then capped at 75 requests per
# 2 hours, so most LI.FI quotes get skipped. Free key: https://portal.li.fi
LIFI_API_KEY=
# LIFI_INTEGRATOR=

# --- Scope ----------------------------------------------------------------
# Empty = all six MVP corridors:
#   sol-sol__sol-usdc, base-usdc__sol-usdc, arb-usdc__sol-usdc,
#   eth-usdc__sol-usdc, base-eth__sol-usdc, base-eth__base-usdc
# CORRIDORS=base-usdc__sol-usdc,sol-sol__sol-usdc
# SIZE_BUCKETS=100,1000,10000
# SOURCES=jupiter,lifi
# SLIPPAGE_BPS=50

# --- Timing ---------------------------------------------------------------
# POLL_INTERVAL=30s
# REQUEST_TIMEOUT=5s
# FLUSH_INTERVAL=5m
# FLUSH_MAX_ROWS=50000
# PAUSE_AFTER_ROUNDS=10
# PAUSE_DURATION=5m

# --- Rate budgets (defaults shown) ------------------------------------------
# JUPITER_RPS=1
# JUPITER_BURST=3
# LIFI_RPS=1.5          # with a key; 0.0104 (75 per 2h) without
# LIFI_BURST=5          # with a key; 2 without

# --- Endpoints (override to point at mocks) ---------------------------------
# JUPITER_ORDER_URL=https://api.jup.ag/swap/v2/order
# LIFI_BASE_URL=https://li.quest
# BINANCE_BASE_URL=https://api.binance.com
# OKX_BASE_URL=https://www.okx.com
# PRICE_VENUES=binance,okx

# Quote-only addresses LI.FI requires as sender/recipient. Nothing is ever
# signed or sent from them; defaults are built in.
# LIFI_EVM_ADDRESS=
# LIFI_SOLANA_ADDRESS=

# --- Ranker ------------------------------------------------------------------
# RANK_INTERVAL=10m
# RANK_WINDOWS=24h,7d
# RANK_TIE_BPS=2          # costs this close count as a tie for win rate
# RANK_MIN_SAMPLES=30     # fewer successful quotes -> low_sample, ranked after the rest

# --- Rankings API -------------------------------------------------------------
# Key FluxPay sends as X-API-Key (16+ chars). Generate one, e.g.:
#   openssl rand -hex 24
API_KEY=
# API_LISTEN_ADDR=127.0.0.1:8081
# API_ALLOW_NO_AUTH=false # only for a private network without a key
# RANKINGS_STALE_AFTER=30m
# COLLECTOR_STALE_AFTER=2m
# RANKINGS_RELOAD_INTERVAL=15s

# --- Shared -------------------------------------------------------------------
# DATA_DIR=./data
# LOG_LEVEL=info
